---
// TEMP QA page — /preloader-qa
// The preloader plays its animation and then HOLDS at the final-logo
// state (no fade-out) over a transparent overlay, so its final logo can
// be lined up against the real nav logo. Dark background so both
// (light) logos are visible. Delete this page once alignment is signed
// off.
import BaseLayout from "../layouts/BaseLayout.astro";
import Preloader from "../components/Preloader.astro";
---

<BaseLayout>
  <Preloader hold={true} />
  <main class="qa-stage">
    <p class="qa-note">
      Preloader QA — animation holds at the final logo. Compare it against
      the nav logo above. (Temp page: /preloader-qa)
    </p>
  </main>
</BaseLayout>

<style>
  .qa-stage {
    min-height: 100vh;
    background: #222323;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem;
  }
  .qa-note {
    max-width: 40rem;
    text-align: center;
    color: rgba(244, 239, 234, 0.5);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
