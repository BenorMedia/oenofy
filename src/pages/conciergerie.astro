---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import introImg from "../assets/conciergerie/intro.png";
import "../styles/conciergerie.css";
---

<BaseLayout
  title="La Conciergerie — OENOFY"
  description="Oenofy is a private wine concierge working with a limited number of clients on collections, private events and collector objects conceived around wine."
  navVariant="dark"
>
  <div class="c-conciergerie-hero">
    <div class="c-conciergerie-hero__media">
      <video
        autoplay
        muted
        loop
        playsinline
        class="c-conciergerie-hero__video"
      >
        <source
          src="/assets/conciergerie/hero-video.mp4"
          type="video/mp4"
        />
      </video>
    </div>
    <div class="c-conciergerie-hero__content">
      <h1 class="c-conciergerie-hero__title">La Conciergerie</h1>
    </div>
  </div>

  <div class="c-conciergerie-flow">
    <!-- Intro — scrolls up and over the fixed hero, same mechanism as
         Hero -> IntroSection on the homepage. -->
    <section class="c-conciergerie-intro">
      <!-- Part 1: heading + copy, side by side -->
      <div class="c-conciergerie-intro__top">
        <div class="c-conciergerie-intro__top-wrap">
          <h2 class="c-conciergerie-intro__heading">Wine concierge</h2>
          <div class="c-conciergerie-intro__copy">
            <p class="c-conciergerie-intro__copy-bold">
              Every engagement begins with dialogue. Before any
              recommendation is made, Oenofy takes time to understand
              how a client lives with wine and what role it plays over
              time.
            </p>
            <p class="c-conciergerie-intro__copy-body">
              No two cellars are approached in the same way. Some wine
              collections develop around longstanding preferences or
              particular interests. Others are shaped more intuitively,
              informed by habits, guests, routines and changing tastes.
              Each collection is built with attention to rhythm,
              balance and long-term coherence rather than short-term
              enthusiasm.
            </p>
          </div>
        </div>
      </div>

      <!-- Part 2: image grows from 70% -> 100% width as it scrolls
           through the sticky stage; locks at 100% once reached. -->
      <div class="c-conciergerie-intro__gallery" data-conciergerie-gallery>
        <div class="c-conciergerie-intro__gallery-sticky">
          <div
            class="c-conciergerie-intro__gallery-image"
            data-conciergerie-gallery-image
          >
            <Image src={introImg} alt="" class="cc-fill_cover" />
          </div>
        </div>
      </div>

      <!-- Part 3: closing copy, right column only -->
      <div class="c-conciergerie-intro__bottom">
        <div class="c-conciergerie-intro__bottom-wrap">
          <div class="c-conciergerie-intro__bottom-spacer"></div>
          <div class="c-conciergerie-intro__bottom-copy">
            <p>
              As a private wine concierge, Oenofy remains involved as
              collections evolve, offering the continuity of a personal
              cellar service. Recommendations are made carefully,
              guided by what belongs within the collection and what
              will continue to bring pleasure in the years ahead.
              Behind the scenes, services such as wine shipping, cellar
              organisation and ongoing wine storage service are
              arranged with the utmost discretion.
            </p>
            <blockquote class="c-conciergerie-intro__quote">
              &ldquo;The level of involvement always remains with the
              client.&rdquo;
            </blockquote>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import "../scripts/conciergerie-page.js";
</script>
