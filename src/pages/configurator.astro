---
import BaseLayout from "../layouts/BaseLayout.astro";
import Configurator from "../components/Configurator.astro";
import { case001 } from "../data/cases.js";

// Review harness for the configurator. The tool is a popup opened from the
// Configure buttons on each /case-n page, so this route is just a trigger:
// it exercises the exact same open/close path the case pages will use.
---

<BaseLayout
  title="Configurator — OENOFY"
  description="Build your Oenofy collection."
  navVariant="dark"
>
  <section class="c-configurator-page">
    <h1 class="c-configurator-page__title cc-fade-up-load">Configurator</h1>
    <p class="c-configurator-page__note">
      Review page for the configurator popup. It opens here exactly the way it
      will from the Configure buttons on a case page.
    </p>
    <button type="button" class="c-configurator-page__cta" data-configurator-open>
      Configure
    </button>
  </section>

  <Configurator caseData={case001} />
</BaseLayout>
