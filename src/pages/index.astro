---
import BaseLayout from "../layouts/BaseLayout.astro";
import Preloader from "../components/Preloader.astro";
import Hero from "../components/Hero.astro";
import IntroSection from "../components/IntroSection.astro";
import { Image } from "astro:assets";

import quoteBg from "../assets/home/quote-bg.png";
import collection1 from "../assets/home/collection1.jpg";
import collection2 from "../assets/home/collection2.jpg";
import collection3 from "../assets/home/collection3.jpg";
import ymcLogo from "../assets/home/ymc-logo.png";
import newsCyprus from "../assets/home/news-cyprus.jpg";
import newsDhondt from "../assets/home/news-dhondt.jpg";
import formBg from "../assets/home/form.png";

// Delivery destinations — main EU countries + USA (placeholder list).
const countries = [
  "United States",
  "United Kingdom",
  "France",
  "Germany",
  "Italy",
  "Spain",
  "Portugal",
  "Netherlands",
  "Belgium",
  "Luxembourg",
  "Ireland",
  "Austria",
  "Switzerland",
  "Sweden",
  "Denmark",
  "Finland",
  "Poland",
  "Greece",
  "Czechia",
  "Hungary",
  "Romania",
];

const newsItems = [
  {
    img: newsCyprus,
    title: "Discover Cyprus Wine",
    subtitle: "Where altitude meets rarity.",
    copy: "Nestled high in the Troodos Mountains, Vouni Panayia is one of Cyprus' most remarkable estates. Its high-altitude vineyards, indigenous grape varieties and meticulous micro-vinifications produce wines of exceptional precision and character. Crafted in extremely limited quantities, each cuvée reflects a distinctive expression of Cyprus' mountainous terroir and a commitment to preserving the island's unique winemaking heritage.",
  },
  {
    img: newsDhondt,
    title: "Dhondt-Grellet",
    subtitle: "Precision without excess. Purity without compromise.",
    copy: "Among the most compelling names of Champagne's new generation, Dhondt-Grellet has earned a reputation for producing remarkably precise, terroir-driven wines. Working primarily with old Chardonnay vines on the Côte des Blancs, the estate embraces low-intervention winemaking, careful élevage and limited production to reveal the character of each individual parcel. Every bottle reflects balance, tension and quiet complexity — champagnes made for those who value authenticity over prestige alone.",
  },
  {
    img: newsCyprus,
    title: "Big Formats",
    subtitle: "Placeholder — scale and presence.",
    copy: "Placeholder copy for an upcoming news item. This block exists so the section is tall enough to scroll through the image reveal animation while the real editorial content is prepared.",
  },
  {
    img: newsDhondt,
    title: "Rare Vintages",
    subtitle: "Placeholder — time in the bottle.",
    copy: "Placeholder copy for an upcoming news item. This block exists so the section is tall enough to scroll through the image reveal animation while the real editorial content is prepared.",
  },
  {
    img: newsCyprus,
    title: "Terroir Stories",
    subtitle: "Placeholder — a sense of place.",
    copy: "Placeholder copy for an upcoming news item. This block exists so the section is tall enough to scroll through the image reveal animation while the real editorial content is prepared.",
  },
  {
    img: newsDhondt,
    title: "The Cellar",
    subtitle: "Placeholder — quiet and cool.",
    copy: "Placeholder copy for an upcoming news item. This block exists so the section is tall enough to scroll through the image reveal animation while the real editorial content is prepared.",
  },
];

import "../styles/home.css";
---

<BaseLayout>
  <Preloader />

  <Hero />

  <!-- Everything below the hero scrolls up and over it as one unit.
       The hero is position:fixed (see .c-hero); this wrapper is the
       opaque, higher-z-index flow that rides over it. -->
  <div class="c-page-flow">
  <IntroSection />

  <!-- Conciergerie + Quote form a sticky-overlap pair: Conciergerie
       holds at the top while Quote scrolls up and over it (same effect
       as the hero). See .c-overlap / .c-conciergerie in home.css. -->
  <div class="c-overlap">
  <!-- Conciergerie -->
  <div class="c-conciergerie">
    <div class="c-conciergerie__media">
      <video
        autoplay
        muted
        loop
        playsinline
        class="cc-fill_cover"
      >
        <source src="/assets/home/conciergerie-placeholder.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="c-conciergerie__overlay"></div>
    <div class="c-conciergerie__box cc-fade-up">
      <h2 class="c-conciergerie__title">La Conciergerie</h2>
      <p class="c-conciergerie__copy">
        Oenofy is a private wine concierge working with a limited number
        of clients on collections, private events and collector objects
        conceived around wine.
      </p>
      <a href="/conciergerie" class="c-conciergerie__link">Explore La Conciergerie →</a>
    </div>
  </div>

  <!-- Quote → collection-reveal stage. On desktop this gets pinned:
       the quote image/text is the backdrop, a dark overlay fades in, and
       the 3 collection cards slide up over it one by one. On mobile the
       pin is skipped and the cards reveal as a normal stacked section. -->
  <div class="c-quote" data-collection-stage>
    <div class="c-quote__display">
      <Image src={quoteBg} alt="" class="cc-fill_cover" />
      <div class="c-quote__box cc-fade-up">
        <p class="c-quote__text">
          &ldquo;Alongside collections and private occasions, a quieter
          expression of the Oenofy world exists. Developed with selected
          designers and artisans, these pieces reflect the same attention to
          detail, materiality and time.&rdquo;
        </p>
      </div>
    </div>

    <!-- Dark overlay — fades in over the quote before the cards arrive. -->
    <div class="c-collection__overlay" data-collection-overlay></div>

    <!-- Collection cards — slide up one by one over the overlay. -->
    <div class="c-collection" data-collection-cards>
      <div class="c-collection__item" data-collection-card>
        <Image src={collection1} alt="" class="cc-fill_cover" />
      </div>
      <div class="c-collection__item c-collection__item--center" data-collection-card>
        <Image src={collection2} alt="" class="cc-fill_cover" />
        <div class="c-collection__caption">
          <h3 class="c-collection__title">Collection</h3>
          <a href="#" class="c-collection__link">Discover →</a>
        </div>
      </div>
      <div class="c-collection__item" data-collection-card>
        <Image src={collection3} alt="" class="cc-fill_cover" />
      </div>
    </div>
  </div>
  </div>

  <!-- Slider — centered carousel: active slide centered, prev/next peek
       at the edges (dimmed via overlay, not filter-blur). 4 identical
       placeholder slides until the client sends real content. -->
  <div class="c-slider cc-fade-up">
    <h2 class="c-slider__title">Where Wine Becomes Experience</h2>
    <div class="c-slider__viewport" data-slider>
      <div class="c-slider__track" data-slider-track>
        {Array.from({ length: 4 }).map(() => (
          <div class="c-slider__slide" data-slider-slide>
            <div class="c-slider__outer">
              <div class="c-slider__inner">
                <h3 class="c-slider__card-title">Monaco - YMC</h3>
                <Image
                  src={ymcLogo}
                  alt="Yacht Club de Monaco"
                  width={480}
                  class="c-slider__logo"
                />
                <a href="#" class="c-slider__link">More information →</a>
              </div>
            </div>
            <div class="c-slider__slide-overlay"></div>
          </div>
        ))}
      </div>

      <button
        class="c-slider__arrow c-slider__arrow--prev"
        data-slider-prev
        aria-label="Previous slide"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 6 9 12 15 18"></polyline>
        </svg>
      </button>
      <button
        class="c-slider__arrow c-slider__arrow--next"
        data-slider-next
        aria-label="Next slide"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 6 15 12 9 18"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- News — single sticky image stage; only one image shows at a time
       and the next wipes in top-to-bottom over it as you scroll through
       the text blocks (see news-animations.js). -->
  <div class="c-news cc-fade-up">
    <h2 class="c-news__title">News</h2>

    <div class="c-news__grid">
      <div class="c-news__media" data-news-media>
        {newsItems.map((item) => (
          <Image src={item.img} alt={item.title} class="c-news__media-img" />
        ))}
      </div>

      <div class="c-news__bodies">
        {newsItems.map((item) => (
          <div class="c-news__body" data-news-body>
            <h3 class="c-news__item-title">{item.title}</h3>
            <p class="c-news__subtitle">{item.subtitle}</p>
            <p class="c-news__copy">{item.copy}</p>
            <a href="#" class="c-news__link">Discover →</a>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Form -->
  <section class="c-form">
    <Image src={formBg} alt="" class="cc-fill_cover" />
    <div class="c-form__inner">
      <h2 class="c-form__title">Request A Quote Or Customization</h2>
      <p class="c-form__intro">
        Every Oenofy collection begins with a conversation.<br />
        Share your project with us and we will prepare a personalised
        proposal based on your objectives, destination and collection profile.
      </p>

      <form class="c-form__form" novalidate>
        <div class="c-form__row c-form__row--triple">
          <div class="c-form__field">
            <label class="c-form__label" for="firstName">First Name *</label>
            <input class="c-form__input" id="firstName" name="firstName" type="text" />
          </div>
          <div class="c-form__field">
            <label class="c-form__label" for="lastName">Last Name *</label>
            <input class="c-form__input" id="lastName" name="lastName" type="text" />
          </div>
          <div class="c-form__field">
            <label class="c-form__label" for="email">Email address *</label>
            <input class="c-form__input" id="email" name="email" type="email" />
          </div>
        </div>

        <div class="c-form__row c-form__row--triple">
          <div class="c-form__field">
            <label class="c-form__label" for="phone">Contact number</label>
            <input class="c-form__input" id="phone" name="phone" type="tel" />
          </div>
          <div class="c-form__field">
            <label class="c-form__label" for="delivery">Delivery to</label>
            <select class="c-form__input c-form__select" id="delivery" name="delivery">
              <option value="" selected hidden></option>
              {countries.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
        </div>

        <div class="c-form__field c-form__field--wide">
          <label class="c-form__label" for="message">
            Anything to add to your request ?
          </label>
          <input
            class="c-form__input c-form__input--message"
            id="message"
            name="message"
            type="text"
            placeholder="Please specify any spacial request , any wish, special occasion or finish if non standard we will find a solution."
          />
        </div>

        <div class="c-form__submit-row">
          <div class="c-form__checks">
            <label class="c-form__check">
              <input type="checkbox" name="age" />
              <span>I confirm that I am of legal drinking age in my country of residence</span>
            </label>
            <label class="c-form__check">
              <input type="checkbox" name="newsletter" checked />
              <span>Yes, I'd love to receive news and personnalized invitations from Oenofy</span>
            </label>
          </div>
          <button type="button" class="c-form__send">Send</button>
        </div>
      </form>

      <p class="c-form__legal">
        By submitting this request, you acknowledge that you have read our
        Privacy Policy<br />
        Submitting a request does not constitute an order or create any payment
        obligation<br />
        OENOFY will use the information provided to review and respond to your
        request. Further information is available in our Privacy Policy.
      </p>
    </div>
  </section>
  </div>
</BaseLayout>

<script>
  import "../scripts/collection-animations.js";
  import "../scripts/slider.js";
  import "../scripts/news-animations.js";
</script>
