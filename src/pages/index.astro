---
import BaseLayout from "../layouts/BaseLayout.astro";
import Preloader from "../components/Preloader.astro";
import Hero from "../components/Hero.astro";
import IntroSection from "../components/IntroSection.astro";
import { Image } from "astro:assets";

import quoteBg from "../assets/home/quote-bg.png";
import collection1 from "../assets/home/collection1.jpg";
import collection2 from "../assets/home/collection2.jpg";
import collection3 from "../assets/home/collection3.jpg";
import ymcLogo from "../assets/home/ymc-logo.png";
import newsCyprus from "../assets/home/news-cyprus.jpg";
import newsDhondt from "../assets/home/news-dhondt.jpg";

import "../styles/home.css";
---

<BaseLayout>
  <Preloader />

  <Hero />

  <!-- Everything below the hero scrolls up and over it as one unit.
       The hero is position:fixed (see .c-hero); this wrapper is the
       opaque, higher-z-index flow that rides over it. -->
  <div class="c-page-flow">
  <IntroSection />

  <!-- Conciergerie + Quote form a sticky-overlap pair: Conciergerie
       holds at the top while Quote scrolls up and over it (same effect
       as the hero). See .c-overlap / .c-conciergerie in home.css. -->
  <div class="c-overlap">
  <!-- Conciergerie -->
  <div class="c-conciergerie">
    <div class="c-conciergerie__media">
      <video
        autoplay
        muted
        loop
        playsinline
        class="cc-fill_cover"
      >
        <source src="/assets/home/conciergerie-placeholder.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="c-conciergerie__overlay"></div>
    <div class="c-conciergerie__box">
      <h2 class="c-conciergerie__title">La Conciergerie</h2>
      <p class="c-conciergerie__copy">
        Oenofy is a private wine concierge working with a limited number
        of clients on collections, private events and collector objects
        conceived around wine.
      </p>
      <a href="#" class="c-conciergerie__link">Explore La Conciergerie →</a>
    </div>
  </div>

  <!-- Quote → collection-reveal stage. On desktop this gets pinned:
       the quote image/text is the backdrop, a dark overlay fades in, and
       the 3 collection cards slide up over it one by one. On mobile the
       pin is skipped and the cards reveal as a normal stacked section. -->
  <div class="c-quote" data-collection-stage>
    <div class="c-quote__display">
      <Image src={quoteBg} alt="" class="cc-fill_cover" />
      <div class="c-quote__box">
        <p class="c-quote__text">
          &ldquo;Alongside collections and private occasions, a quieter
          expression of the Oenofy world exists. Developed with selected
          designers and artisans, these pieces reflect the same attention to
          detail, materiality and time.&rdquo;
        </p>
      </div>
    </div>

    <!-- Dark overlay — fades in over the quote before the cards arrive. -->
    <div class="c-collection__overlay" data-collection-overlay></div>

    <!-- Collection cards — slide up one by one over the overlay. -->
    <div class="c-collection" data-collection-cards>
      <div class="c-collection__item" data-collection-card>
        <Image src={collection1} alt="" class="cc-fill_cover" />
      </div>
      <div class="c-collection__item c-collection__item--center" data-collection-card>
        <Image src={collection2} alt="" class="cc-fill_cover" />
        <div class="c-collection__caption">
          <h3 class="c-collection__title">Collection</h3>
          <a href="#" class="c-collection__link">Discover →</a>
        </div>
      </div>
      <div class="c-collection__item" data-collection-card>
        <Image src={collection3} alt="" class="cc-fill_cover" />
      </div>
    </div>
  </div>
  </div>

  <!-- Slider — centered carousel: active slide centered, prev/next peek
       at the edges (dimmed via overlay, not filter-blur). 4 identical
       placeholder slides until the client sends real content. -->
  <div class="c-slider">
    <h2 class="c-slider__title">Where Wine Becomes Experience</h2>
    <div class="c-slider__viewport" data-slider>
      <div class="c-slider__track" data-slider-track>
        {Array.from({ length: 4 }).map(() => (
          <div class="c-slider__slide" data-slider-slide>
            <div class="c-slider__outer">
              <div class="c-slider__inner">
                <h3 class="c-slider__card-title">Monaco - YMC</h3>
                <Image
                  src={ymcLogo}
                  alt="Yacht Club de Monaco"
                  width={480}
                  class="c-slider__logo"
                />
                <a href="#" class="c-slider__link">More information →</a>
              </div>
            </div>
            <div class="c-slider__slide-overlay"></div>
          </div>
        ))}
      </div>

      <button
        class="c-slider__arrow c-slider__arrow--prev"
        data-slider-prev
        aria-label="Previous slide"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 6 9 12 15 18"></polyline>
        </svg>
      </button>
      <button
        class="c-slider__arrow c-slider__arrow--next"
        data-slider-next
        aria-label="Next slide"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 6 15 12 9 18"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- News -->
  <div class="c-news">
    <h2 class="c-news__title">News</h2>

    <div class="c-news__grid">
    <div class="c-news__row">
      <div class="c-news__image">
        <Image
          src={newsCyprus}
          alt="Discover Cyprus Wine"
          class="c-news__media"
        />
      </div>
      <div class="c-news__body">
        <h3 class="c-news__item-title">Discover Cyprus Wine</h3>
        <p class="c-news__subtitle">Where altitude meets rarity.</p>
        <p class="c-news__copy">
          Nestled high in the Troodos Mountains, Vouni Panayia is one of
          Cyprus' most remarkable estates. Its high-altitude vineyards,
          indigenous grape varieties and meticulous micro-vinifications
          produce wines of exceptional precision and character. Crafted in
          extremely limited quantities, each cuvée reflects a distinctive
          expression of Cyprus' mountainous terroir and a commitment to
          preserving the island's unique winemaking heritage.
        </p>
        <a href="#" class="c-news__link">Discover →</a>
      </div>
    </div>

    <div class="c-news__row">
      <div class="c-news__image">
        <Image
          src={newsDhondt}
          alt="Dhondt-Grellet"
          class="c-news__media"
        />
      </div>
      <div class="c-news__body">
        <h3 class="c-news__item-title">Dhondt-Grellet</h3>
        <p class="c-news__subtitle">
          Precision without excess. Purity without compromise.
        </p>
        <p class="c-news__copy">
          Among the most compelling names of Champagne's new generation,
          Dhondt-Grellet has earned a reputation for producing remarkably
          precise, terroir-driven wines. Working primarily with old
          Chardonnay vines on the Côte des Blancs, the estate embraces
          low-intervention winemaking, careful élevage and limited
          production to reveal the character of each individual parcel.
          Every bottle reflects balance, tension and quiet complexity —
          champagnes made for those who value authenticity over prestige
          alone.
        </p>
        <a href="#" class="c-news__link">Discover →</a>
      </div>
    </div>

    <div class="c-news__row">
      <div class="c-news__image">
        <Image src={newsCyprus} alt="Big Formats" class="c-news__media" />
      </div>
      <div class="c-news__body">
        <h3 class="c-news__item-title">Big Formats</h3>
        <p class="c-news__subtitle">Placeholder — scale and presence.</p>
        <p class="c-news__copy">
          Placeholder copy for an upcoming news item. This row exists so
          the section is tall enough to scroll through the image overlap
          animation while the real editorial content is prepared.
        </p>
        <a href="#" class="c-news__link">Discover →</a>
      </div>
    </div>

    <div class="c-news__row">
      <div class="c-news__image">
        <Image src={newsDhondt} alt="Rare Vintages" class="c-news__media" />
      </div>
      <div class="c-news__body">
        <h3 class="c-news__item-title">Rare Vintages</h3>
        <p class="c-news__subtitle">Placeholder — time in the bottle.</p>
        <p class="c-news__copy">
          Placeholder copy for an upcoming news item. This row exists so
          the section is tall enough to scroll through the image overlap
          animation while the real editorial content is prepared.
        </p>
        <a href="#" class="c-news__link">Discover →</a>
      </div>
    </div>

    <div class="c-news__row">
      <div class="c-news__image">
        <Image src={newsCyprus} alt="Terroir Stories" class="c-news__media" />
      </div>
      <div class="c-news__body">
        <h3 class="c-news__item-title">Terroir Stories</h3>
        <p class="c-news__subtitle">Placeholder — a sense of place.</p>
        <p class="c-news__copy">
          Placeholder copy for an upcoming news item. This row exists so
          the section is tall enough to scroll through the image overlap
          animation while the real editorial content is prepared.
        </p>
        <a href="#" class="c-news__link">Discover →</a>
      </div>
    </div>

    <div class="c-news__row">
      <div class="c-news__image">
        <Image src={newsDhondt} alt="The Cellar" class="c-news__media" />
      </div>
      <div class="c-news__body">
        <h3 class="c-news__item-title">The Cellar</h3>
        <p class="c-news__subtitle">Placeholder — quiet and cool.</p>
        <p class="c-news__copy">
          Placeholder copy for an upcoming news item. This row exists so
          the section is tall enough to scroll through the image overlap
          animation while the real editorial content is prepared.
        </p>
        <a href="#" class="c-news__link">Discover →</a>
      </div>
    </div>
    </div>
  </div>
  </div>
</BaseLayout>

<script>
  import "../scripts/collection-animations.js";
  import "../scripts/slider.js";
</script>
