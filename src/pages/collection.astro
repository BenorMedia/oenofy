---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import introImg from "../assets/collection/intro-img.png";
import case1 from "../assets/collection/case1.png";
import case2 from "../assets/collection/case2.png";
import CtaForm from "../components/CtaForm.astro";
import "../styles/collection.css";
---

<BaseLayout
  title="Collection — OENOFY"
  description="Explore the Oenofy collection — curated pieces conceived around wine."
  navVariant="dark"
>
  <div class="c-collection-hero">
    <div class="c-collection-hero__media">
      <video autoplay muted loop playsinline class="c-collection-hero__video">
        <source src="/assets/collection/collection-hero.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="c-collection-hero__content">
      <h1 class="c-collection-hero__title cc-fade-up-load">Collection</h1>
    </div>
  </div>

  <div class="c-collection-flow">
    <!-- Intro — scrolls up and over the fixed hero, same mechanism as
         Hero -> IntroSection on the homepage. -->
    <section class="c-collection-intro">
      <!-- Part 1: heading + copy, side by side -->
      <div class="c-collection-intro__top">
        <div class="c-collection-intro__top-wrap">
          <h2 class="c-collection-intro__heading cc-fade-up">
            Wine Gift Boxes And Collector Objects
          </h2>
          <div class="c-collection-intro__copy cc-fade-up" data-fade-delay="0.2">
            <p class="c-collection-intro__copy-bold">
              Oenofy creates collector objects around wine. Conceived
              from the beginning as singular pieces, each one is defined
              by material selection, craftsmanship and enduring
              presence.
            </p>
            <p class="c-collection-intro__copy-body">
              Developed in collaboration with selected designers and
              artisans, the work is intentional and quietly timeless.
              Editions remain limited. Attention is given to balance,
              detail and the lasting quality of the object itself.
              These are not presentation boxes, but carefully crafted
              objects designed to endure.
            </p>
          </div>
        </div>
      </div>

      <!-- Part 2: image grows from 70% -> 100% width as it scrolls
           through the sticky stage; locks at 100% once reached. -->
      <div class="c-collection-intro__gallery" data-intro-gallery>
        <div class="c-collection-intro__gallery-sticky">
          <div
            class="c-collection-intro__gallery-image"
            data-intro-gallery-image
          >
            <Image src={introImg} alt="" class="cc-fill_cover" />
          </div>
        </div>
      </div>

      <!-- Part 3: closing copy, right column only -->
      <div class="c-collection-intro__bottom cc-fade-up">
        <div class="c-collection-intro__bottom-wrap">
          <div class="c-collection-intro__bottom-spacer"></div>
          <div class="c-collection-intro__bottom-copy">
            <p>
              Each collection is created to become part of its owner's
              environment rather than a temporary presentation. Designed
              with longevity in mind, every object is intended to age
              gracefully, acquiring character through time while
              preserving its purpose and presence.
            </p>
            <p>
              Quiet by nature, each edition reflects an appreciation for
              thoughtful design, fine materials and lasting
              craftsmanship.
            </p>
            <blockquote class="c-collection-intro__quote">
              &ldquo;The wine is part of the object. The object is what
              remains.&rdquo;
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- Cases — 3 cards stacked one below another, no animation. -->
    <section class="c-collection-cases">
      <div class="c-collection-cases__card">
        <Image src={case1} alt="Case 001" class="cc-fill_cover" />
        <div class="c-collection-cases__content">
          <h3 class="c-collection-cases__title">Case 001</h3>
          <a href="#" class="c-collection-cases__link">Discover →</a>
        </div>
      </div>
      <div class="c-collection-cases__card">
        <Image src={case2} alt="Case 002" class="cc-fill_cover" />
        <div class="c-collection-cases__content">
          <h3 class="c-collection-cases__title">Case 002</h3>
          <a href="#" class="c-collection-cases__link">Discover →</a>
        </div>
      </div>
      <div class="c-collection-cases__card">
        <Image src={case1} alt="Case 003" class="cc-fill_cover" />
        <div class="c-collection-cases__content">
          <h3 class="c-collection-cases__title">Case 003</h3>
          <a href="#" class="c-collection-cases__link">Discover →</a>
        </div>
      </div>
    </section>

  <!-- Form CTA -->
  <CtaForm />
  </div>
</BaseLayout>

<script>
  import "../scripts/collection-page.js";
</script>
