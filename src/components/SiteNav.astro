---
import "../styles/site-nav.css";
import LogoMark from "./LogoMark.astro";

interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;
---

<nav
  id="site-nav"
  class:list={["c-nav", { "c-nav--dark": variant === "dark" }]}
  data-nav
>
  <div class="c-nav__group">
    <a href="/conciergerie" class="c-nav__link">Conciergerie</a>
    <a href="/collection" class="c-nav__link">Collection</a>
  </div>

  <a href="/" class="c-nav__mark" aria-label="Oenofy — Home">
    <LogoMark />
  </a>

  <div class="c-nav__group">
    <a href="/events" class="c-nav__link">Events</a>
    <a href="#" class="c-nav__link">Contact us</a>
  </div>
</nav>

<script>
  import "../scripts/site-nav.js";
</script>
