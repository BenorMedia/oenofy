---
import "../styles/preloader.css";
---

<section class="oenofy-intro" data-oenofy-intro>
  <div class="oenofy-intro__bg"></div>

  <div class="oenofy-intro__logo-stage" aria-hidden="true">

    <div class="oenofy-intro__split-logo">

      <!-- O 1 -->
      <svg class="oenofy-glyph oenofy-glyph--o oenofy-glyph--o1" viewBox="0 0 93.096 80.136" xmlns="http://www.w3.org/2000/svg">
        <path d="M46.548 0C20.88 0 0 17.964 0 40.068C0 62.172 20.88 80.136 46.548 80.136C72.216 80.136 93.096 62.172 93.096 40.068C93.096 17.964 72.216 0 46.548 0ZM86.652 40.104C86.652 58.68 68.652 73.764 46.512 73.764C24.372 73.764 6.37199 58.644 6.37199 40.104C6.37199 21.564 24.372 6.444 46.512 6.444C68.652 6.444 86.652 21.564 86.652 40.104Z" fill="#F4EFEA"/>
      </svg>

      <!-- E -->
      <svg class="oenofy-glyph oenofy-glyph--letter oenofy-glyph--e" viewBox="130 0 62 81" xmlns="http://www.w3.org/2000/svg">
        <path d="M136.432 71.6581V43.47H182.512V38.214H136.432V8.44203H186.616V3.22205H130.096V76.914H189.82V71.6581H136.432Z" fill="#F4EFEA"/>
      </svg>

      <!-- N -->
      <svg class="oenofy-glyph oenofy-glyph--letter oenofy-glyph--n" viewBox="225 0 76 81" xmlns="http://www.w3.org/2000/svg">
        <path d="M292.412 3.22205V65.79L230.852 3.22205H230.816H226.82V76.914H233.192V14.31L294.752 76.914H298.784V3.22205H292.412Z" fill="#F4EFEA"/>
      </svg>

      <!-- O 2 -->
      <svg class="oenofy-glyph oenofy-glyph--o oenofy-glyph--o2" viewBox="335.784 0 93.096 80.136" xmlns="http://www.w3.org/2000/svg">
        <path d="M382.332 0C356.664 0 335.784 17.964 335.784 40.068C335.784 62.172 356.664 80.136 382.332 80.136C408 80.136 428.88 62.172 428.88 40.068C428.88 17.964 408 0 382.332 0ZM422.472 40.104C422.472 58.68 404.472 73.764 382.332 73.764C360.192 73.764 342.192 58.644 342.192 40.104C342.192 21.564 360.192 6.444 382.332 6.444C404.472 6.444 422.472 21.564 422.472 40.104Z" fill="#F4EFEA"/>
      </svg>

      <!-- F -->
      <svg class="oenofy-glyph oenofy-glyph--letter oenofy-glyph--f" viewBox="465 0 60 81" xmlns="http://www.w3.org/2000/svg">
        <path d="M522.4 8.44203V3.22205H465.88V76.914H472.252V43.47H518.332V38.214H472.252V8.44203H522.4Z" fill="#F4EFEA"/>
      </svg>

      <!-- Y -->
      <svg class="oenofy-glyph oenofy-glyph--letter oenofy-glyph--y" viewBox="558 0 77 81" xmlns="http://www.w3.org/2000/svg">
        <path d="M625.496 3.22205L597.272 40.41L567.5 3.22205H559.4L594.176 46.494V76.914H600.548V46.494L633.596 3.22205H625.496Z" fill="#F4EFEA"/>
      </svg>

    </div>

    <div class="oenofy-transition-os" aria-hidden="true">
      <span class="oenofy-transition-o oenofy-transition-o--1"></span>
      <span class="oenofy-transition-o oenofy-transition-o--2"></span>
    </div>

    <!-- FINAL PNG LOGO -->
    <img
      class="oenofy-final-logo"
      src="https://cdn.prod.website-files.com/69fdd0067f429dab904ad307/6a1811a528eb23cff2aff983_logo.png"
      alt=""
      aria-hidden="true"
    />

  </div>

  <div class="oenofy-intro__content">
    <h1>
      Modern wine concierge is<br>
      currently being prepared.
    </h1>

    <a href="/contact" class="oenofy-intro__button">
      Get in touch
    </a>
  </div>
</section>

<script>
  import "../scripts/preloader.js";
</script>
